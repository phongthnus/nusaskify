PORT=3000
DATABASE_URL=postgres://nus:nus@localhost:5434/nusaskify

# Ollama (https://docs.ollama.com/quickstart)
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=qwen3-embedding:0.6b
# Must match the embedding model's output dimension (qwen3-embedding:0.6b -> 1024).
# Changing it requires dropping the chunks table (the column is vector(EMBED_DIM)).
EMBED_DIM=1024
CHAT_MODEL=qwen3:4b-instruct

# Retrieval
DEFAULT_TOP_K=5
# If the best cosine similarity is below this, /api/ask answers "not enough information".
# Tune it empirically with /api/search (record scores of good vs. unrelated questions).
MIN_SCORE=0.47

# Semantic chunking (Chonkie SemanticChunker)
SEMANTIC_THRESHOLD=0.75
SEMANTIC_CHUNK_SIZE=600
# Structure-based chunking (Chonkie RecursiveChunker)
STRUCTURE_CHUNK_SIZE=400
