{
  "name": "nusaskify-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "sample-docs": "tsx scripts/generate-sample-docs.ts",
    "seed": "tsx ../tests/seed.mts",
    "test-cases": "tsx ../tests/run-test-cases.mts"
  },
  "dependencies": {
    "@chonkiejs/core": "^0.0.12",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "ollama": "^0.6.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "docx": "^9.15.3",
    "pdfkit": "^0.17.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
